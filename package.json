{
  "name": "ios-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "tsc --noEmit && eslint . && stylelint styles.css && prettier --check src tests scripts *.json *.mjs styles.css",
    "test": "node --test --experimental-test-coverage tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "obsidian": "1.13.1",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
